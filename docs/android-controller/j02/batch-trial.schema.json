{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "trialId": {
      "type": "string"
    },
    "started": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "completed",
        "stopped",
        "unverified",
        "not_run"
      ]
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claimedComplete": {
      "type": "boolean"
    },
    "independent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "verdict",
        "checks"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "jevCalls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "mainAgentCalls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "mainModelRequests": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "humanHandoffs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actions",
        "observations",
        "jevCalls",
        "mainAgentCalls",
        "mainModelRequests",
        "humanHandoffs"
      ]
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "verified",
              "dispatched",
              "unknown",
              "failed"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "requestedModel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "returnedModel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "totalTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "inputTokens",
              "outputTokens",
              "totalTokens"
            ]
          }
        },
        "required": [
          "provider",
          "requestedModel",
          "returnedModel",
          "usage"
        ]
      }
    },
    "recoveryAttempted": {
      "type": "boolean"
    },
    "escalationRequested": {
      "type": "boolean"
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "resetMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "independentCheckMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "endToEndMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "taskMs",
        "resetMs",
        "independentCheckMs",
        "endToEndMs"
      ]
    },
    "invalidations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
      }
    },
    "cleanupProven": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "sha256"
        ]
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite": {
          "enum": [
            "androidworld",
            "androidlab"
          ]
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "method": {
          "enum": [
            "native_task",
            "isolated_native_judge_final_state"
          ]
        },
        "setup": {
          "type": "boolean"
        },
        "cleanup": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "suite",
        "taskId",
        "method",
        "setup",
        "cleanup",
        "verdict",
        "score",
        "code"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "trialId",
    "started",
    "status",
    "code",
    "claimedComplete",
    "independent",
    "counts",
    "receipts",
    "models",
    "recoveryAttempted",
    "escalationRequested",
    "timings",
    "invalidations",
    "cleanupProven",
    "artifacts"
  ]
}
