# AndroidController 配置模板
# 复制为 config.env 后按本机情况修改；config.env 已被 .gitignore 排除，
# 因为它记录本机 adb 绝对路径与已配对设备序列号。
# 每行 KEY=VALUE，注释用 # 开头

# adb 可执行文件。留空则用 PATH 中的 adb。
# 示例：C:\platform-tools\adb.exe
ADB_PATH=

# 默认设备。留空自动选第一台已授权设备。
# 无线示例：192.168.1.20:5555
DEVICE_SERIAL=

# 单次 adb 命令超时（毫秒）
ADB_TIMEOUT_MS=20000

# 控件树优先走设备端常驻服务（u2 JSON-RPC）。关闭后回退冷启的 uiautomator dump，感知显著变慢。
UI_SERVER=true

# 感知时屏幕已灭则发送一次唤醒键；不自动解锁。
AUTO_WAKE=true

# 显示屏服务端口（仅监听 127.0.0.1）。0 表示随机分配。
DISPLAY_PORT=5977

# 推流参数
STREAM_FORMAT=jpeg
# auto 先试 raw，失败降级 PNG；png 强制老路径
STREAM_CAPTURE_MODE=auto
STREAM_QUALITY=70
STREAM_INTERVAL_MS=400
STREAM_MAX_WIDTH=540

# H.264 通道：画面最长边、码率、最大帧率
SCRCPY_MAX_SIZE=540
SCRCPY_BIT_RATE=2000000
SCRCPY_MAX_FPS=30

# 显示屏在 Loom 侧栏中的应用标识
LOOM_APP_ID=android-mirror
