# AndroidController 配置模板
# 复制为 config.env 后按本机情况修改；config.env 已被 .gitignore 排除，
# 因为它记录本机 adb 绝对路径与已配对设备序列号。
# 每行 KEY=VALUE，注释用 # 开头
# 桌面安卓设置的「控制器」页可编辑常用项，保存到此文件，重启 VCPChat 生效。
# 画质与显示方式另存 AppData/android-display-preferences.json，保存后即时应用。

# adb 可执行文件。留空则用 PATH 中的 adb。
# 示例：C:\platform-tools\adb.exe
ADB_PATH=

# 默认设备。留空自动选第一台已授权设备。
# 无线示例：192.168.1.20:5555
DEVICE_SERIAL=

# 单次 adb 命令超时（毫秒）
ADB_TIMEOUT_MS=20000

# 控件树优先走设备端常驻服务（u2 JSON-RPC）。关闭后回退冷启的 uiautomator dump，感知显著变慢。
UI_SERVER=true

# 非 ASCII 输入时，写入剪贴板后用哪个原语贴入光标：
#   keyevent（默认）KEYCODE_PASTE，已实测在原生 EditText 与 WebView 上都可用
#   rpc              设备端 pasteClipboard（在 ColorOS / Android 17 上抛 AssertionError）
#   off              不粘贴，宁可失败也不发散入事件
CLIPBOARD_PASTE=keyevent

# 感知时屏幕已灭则发送一次唤醒键；不自动解锁。
AUTO_WAKE=true

# 后台自动连接已配对的无线调试手机（网络变化/断线后自动重连）。首次仍需配对一次。
AUTO_CONNECT=true

# 交互策略JSON：denyPackages拒读写，readOnlyPackages禁写，confirmEveryWrite要求逐次批准。
# 默认{}对敏感写要求宿主原生对话框逐次批准；无可信服务拒绝，不接受模型confirmed，deny/readOnly不能被批准覆盖。
INTERACTION_POLICY={}

# 显示屏服务端口（仅监听 127.0.0.1）。0 表示随机分配。
DISPLAY_PORT=5977

# 推流参数
STREAM_FORMAT=jpeg
# auto 先试 raw，失败降级 PNG；png 强制老路径
STREAM_CAPTURE_MODE=auto
STREAM_QUALITY=70
STREAM_INTERVAL_MS=400
STREAM_MAX_WIDTH=540

# H.264 通道：画面最长边、码率、最大帧率
SCRCPY_MAX_SIZE=540
SCRCPY_BIT_RATE=2000000
SCRCPY_MAX_FPS=30

# 显示屏在 Loom 侧栏中的应用标识
LOOM_APP_ID=android-mirror
